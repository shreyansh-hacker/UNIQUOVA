# YOUR BRAND Growth Agency - Environment Variables Example
# Duplicate this file as .env.local and configure your keys

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://yourbrand.agency

# Public Brand Display
NEXT_PUBLIC_BRAND_NAME="YOUR BRAND"
NEXT_PUBLIC_CONTACT_EMAIL="growth@yourbrand.agency"
NEXT_PUBLIC_CONTACT_PHONE="+91 (0) 800-YOUR-BRAND"

# Optional Backend Integrations (CRM / Email / Slack notification webhooks)
# When ready to route audit form submissions to an actual email/CRM backend:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SLACK_AUDIT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
